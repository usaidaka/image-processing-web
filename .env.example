# ==========================================
# ⚙️ GLOBAL ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# This project uses different .env files for different components.
# Copy the relevant sections to the respective folders.

# ------------------------------------------
# 1. FRONTEND: Save as `frontend/.env`
# ------------------------------------------
# Tells the React frontend where the backend API is located.
# Important: Without this, you will get "Unexpected end of JSON input" errors
# because the frontend will try to send requests to its own port (5173).
VITE_API_URL=http://localhost:3001

# ------------------------------------------
# 2. BACKEND: Save as `backend/.env`
# ------------------------------------------
# Express server configuration
PORT=3001
# Redis connection for the backend queue producer
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------
# 3. WORKER: Save as `worker/.env`
# ------------------------------------------
# Redis connection for the background processing worker
REDIS_HOST=localhost
REDIS_PORT=6379
