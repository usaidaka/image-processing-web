{
  "name": "async-image-processing",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev": "docker-compose up --build",
    "dev:backend": "cd backend && npx ts-node src/index.ts",
    "dev:worker": "cd worker && npx ts-node src/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../worker && npm install"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
